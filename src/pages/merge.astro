---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<header class="nav">
			<a class="back" href="/pains/birthday-blindspot">← Back to pain</a>
			<span class="pill">Merge festival · live</span>
		</header>

		<section class="hero">
			<p class="eyebrow">Ideas are converging</p>
			<h1>The Merge Festival</h1>
			<p class="sub">
				When proposals overlap, Painora invites them to become one. Contributors negotiate,
				AI maps compatibility, and the strongest idea emerges.
			</p>
		</section>

		<!-- Pain context -->
		<div class="pain-ref">
			<span class="pain-label">Pain being solved</span>
			<span class="pain-title">"I always forget my friends' birthdays until the day of"</span>
		</div>

		<!-- The merge arena -->
		<div class="arena" id="arena">
			<!-- Proposal A -->
			<div class="proposal-card card-a">
				<div class="card-author">M. Reyes</div>
				<h3>Relationship graph with weighted reminders</h3>
				<p>Map contacts by closeness tier. Surface reminders 7, 3, and 1 day before — only for people who matter.</p>
				<div class="card-tags">
					<span>relationship model</span>
					<span>tiered alerts</span>
				</div>
				<div class="card-votes">↑ 214 votes</div>
			</div>

			<!-- Merge visual -->
			<div class="merge-zone">
				<div class="merge-ring ring-1"></div>
				<div class="merge-ring ring-2"></div>
				<div class="merge-ring ring-3"></div>
				<div class="merge-icon">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M8 6H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/>
						<path d="M16 6h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3"/>
						<path d="M12 3v18"/>
						<path d="M9 9l3-3 3 3"/>
						<path d="M9 15l3 3 3-3"/>
					</svg>
				</div>
				<div class="merge-label">Merging</div>
			</div>

			<!-- Proposal B -->
			<div class="proposal-card card-b">
				<div class="card-author">S. Nakamura</div>
				<h3>Native calendar sync + AI gift suggestions</h3>
				<p>Sync across all contact sources. One day before, surface a curated shortlist of meaningful gifts.</p>
				<div class="card-tags">
					<span>cross-platform sync</span>
					<span>gift intelligence</span>
				</div>
				<div class="card-votes">↑ 189 votes</div>
			</div>
		</div>

		<!-- Result -->
		<div class="result-wrap">
			<div class="result-arrow">
				<div class="arrow-line"></div>
				<svg class="arrow-head" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M12 5v14M5 12l7 7 7-7"/>
				</svg>
			</div>

			<div class="merged-card">
				<div class="merged-badge">
					<span class="badge-dot"></span>
					Merged result · v1
				</div>
				<h2>Relationship-aware birthday OS with gift intelligence</h2>
				<p class="merged-desc">
					A unified system that maps contact closeness, syncs across all calendar sources, and surfaces
					proactive reminders with curated gift ideas — weighted by how much you care about each person.
				</p>
				<div class="merged-attrs">
					<div class="attr">
						<span class="attr-label">Core IP</span>
						<span>M. Reyes · S. Nakamura</span>
					</div>
					<div class="attr">
						<span class="attr-label">Compatibility</span>
						<span class="compat">98% overlap</span>
					</div>
					<div class="attr">
						<span class="attr-label">Total votes</span>
						<span>403</span>
					</div>
				</div>

				<div class="merged-actions">
					<a class="primary" href="/pains/birthday-blindspot#propose">Join as builder</a>
					<a class="ghost" href="/pains">See all pains</a>
				</div>
			</div>
		</div>

		<!-- Quote -->
		<blockquote class="philosophy">
			"When ideas overlap, Painora helps them become one."
		</blockquote>

		<footer class="footer">
			<span>© 2026 Painora</span>
			<a href="/pains">← Pain library</a>
		</footer>
	</div>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0c0b11;
		color: #f5f2ea;
		font-family: 'Space Grotesk', system-ui, sans-serif;
	}

	:global(*) { box-sizing: border-box; }

	.page {
		min-height: 100vh;
		padding: 32px clamp(20px, 6vw, 96px) 80px;
		background:
			radial-gradient(ellipse at 20% 20%, rgba(243,163,92,0.18), transparent 55%),
			radial-gradient(ellipse at 80% 20%, rgba(104,199,209,0.18), transparent 55%),
			radial-gradient(ellipse at 50% 60%, rgba(155,138,255,0.12), transparent 50%),
			#0c0b11;
	}

	/* Nav */
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 48px;
	}

	.back {
		color: rgba(245,242,234,0.6);
		text-decoration: none;
		font-size: 14px;
		transition: color 0.2s;
	}

	.back:hover { color: #f5f2ea; }

	.pill {
		padding: 6px 14px;
		border-radius: 999px;
		background: rgba(243,163,92,0.18);
		color: #f3a35c;
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		animation: pulse-pill 2.5s ease-in-out infinite;
	}

	/* Hero */
	.hero {
		text-align: center;
		max-width: 600px;
		margin: 0 auto 40px;
		animation: fade-up 0.7s ease forwards;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 12px;
		color: #f3a35c;
		margin: 0 0 12px;
	}

	.hero h1 {
		font-family: 'Fraunces', serif;
		font-size: clamp(36px, 5vw, 64px);
		margin: 0 0 16px;
		line-height: 1.05;
		background: linear-gradient(120deg, #f3a35c, #f16068, #9b8aff);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.sub {
		margin: 0;
		color: rgba(245,242,234,0.7);
		font-size: 17px;
		line-height: 1.65;
	}

	/* Pain ref */
	.pain-ref {
		display: flex;
		align-items: center;
		gap: 12px;
		justify-content: center;
		margin-bottom: 48px;
		animation: fade-up 0.7s 0.1s ease both;
	}

	.pain-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: rgba(245,242,234,0.35);
	}

	.pain-title {
		font-size: 14px;
		color: rgba(245,242,234,0.7);
		font-style: italic;
	}

	/* Arena */
	.arena {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 24px;
		align-items: center;
		max-width: 900px;
		margin: 0 auto 16px;
		animation: fade-up 0.7s 0.2s ease both;
	}

	/* Proposal cards */
	.proposal-card {
		padding: 24px;
		border-radius: 22px;
		background: rgba(18,17,28,0.95);
		border: 1px solid rgba(245,242,234,0.08);
		display: grid;
		gap: 10px;
		position: relative;
		overflow: hidden;
	}

	.card-a {
		border-color: rgba(243,163,92,0.25);
		box-shadow: 0 0 40px rgba(243,163,92,0.08);
		animation: slide-in-left 0.9s 0.3s ease both, glow-a 3s 1.2s ease-in-out infinite;
	}

	.card-b {
		border-color: rgba(104,199,209,0.25);
		box-shadow: 0 0 40px rgba(104,199,209,0.08);
		animation: slide-in-right 0.9s 0.3s ease both, glow-b 3s 1.2s ease-in-out infinite;
	}

	.card-author {
		font-size: 12px;
		color: rgba(245,242,234,0.45);
	}

	.proposal-card h3 {
		font-family: 'Fraunces', serif;
		font-size: 17px;
		margin: 0;
		line-height: 1.3;
		color: #f5f2ea;
	}

	.proposal-card p {
		font-size: 14px;
		line-height: 1.55;
		color: rgba(245,242,234,0.65);
		margin: 0;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.card-tags span {
		font-size: 11px;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(245,242,234,0.06);
		color: rgba(245,242,234,0.45);
	}

	.card-votes {
		font-size: 13px;
		color: rgba(245,242,234,0.4);
	}

	/* Merge zone */
	.merge-zone {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		position: relative;
		width: 80px;
	}

	.merge-ring {
		position: absolute;
		border-radius: 50%;
		border: 1px solid rgba(155,138,255,0.3);
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) scale(0);
		animation: ring-expand 2.4s ease-out infinite;
	}

	.ring-1 { width: 60px;  height: 60px;  animation-delay: 0s; }
	.ring-2 { width: 100px; height: 100px; animation-delay: 0.5s; }
	.ring-3 { width: 140px; height: 140px; animation-delay: 1s; }

	.merge-icon {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(155,138,255,0.15);
		border: 1px solid rgba(155,138,255,0.35);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #9b8aff;
		position: relative;
		z-index: 1;
		animation: icon-pulse 2.4s ease-in-out infinite;
	}

	.merge-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgba(155,138,255,0.7);
		position: relative;
		z-index: 1;
	}

	/* Result */
	.result-wrap {
		max-width: 900px;
		margin: 0 auto;
		animation: fade-up 0.8s 0.7s ease both;
	}

	.result-arrow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		margin-bottom: 0;
	}

	.arrow-line {
		width: 1px;
		height: 40px;
		background: linear-gradient(to bottom, rgba(155,138,255,0.4), rgba(155,138,255,0.1));
	}

	.arrow-head {
		color: rgba(155,138,255,0.5);
		margin-top: -4px;
	}

	.merged-card {
		border-radius: 24px;
		padding: 32px 36px;
		background: linear-gradient(140deg, rgba(155,138,255,0.12), rgba(104,199,209,0.08), rgba(243,163,92,0.08));
		border: 1px solid rgba(155,138,255,0.3);
		box-shadow:
			0 0 60px rgba(155,138,255,0.12),
			0 24px 60px rgba(0,0,0,0.4);
		display: grid;
		gap: 16px;
	}

	.merged-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #9b8aff;
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #9b8aff;
		animation: dot-pulse 1.8s ease-in-out infinite;
	}

	.merged-card h2 {
		font-family: 'Fraunces', serif;
		font-size: clamp(22px, 3vw, 34px);
		margin: 0;
		line-height: 1.2;
		color: #f5f2ea;
	}

	.merged-desc {
		margin: 0;
		font-size: 16px;
		line-height: 1.7;
		color: rgba(245,242,234,0.75);
		max-width: 620px;
	}

	.merged-attrs {
		display: flex;
		gap: 28px;
		flex-wrap: wrap;
		padding-top: 4px;
	}

	.attr {
		display: grid;
		gap: 4px;
	}

	.attr-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: rgba(245,242,234,0.4);
	}

	.attr span:not(.attr-label) {
		font-size: 14px;
		color: rgba(245,242,234,0.85);
	}

	.compat {
		color: #7ec99b !important;
	}

	.merged-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		padding-top: 4px;
	}

	.primary {
		background: linear-gradient(120deg, #f3a35c, #f16068);
		color: #0c0b11;
		border-radius: 999px;
		padding: 12px 22px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		box-shadow: 0 6px 20px rgba(243,163,92,0.3);
		transition: transform 0.2s;
	}

	.primary:hover { transform: translateY(-2px); }

	.ghost {
		border: 1px solid rgba(245,242,234,0.18);
		color: #f5f2ea;
		background: rgba(245,242,234,0.05);
		border-radius: 999px;
		padding: 12px 22px;
		font-size: 14px;
		text-decoration: none;
		transition: background 0.2s;
	}

	.ghost:hover { background: rgba(245,242,234,0.1); }

	/* Philosophy quote */
	.philosophy {
		text-align: center;
		font-family: 'Fraunces', serif;
		font-size: clamp(18px, 2.5vw, 26px);
		color: rgba(245,242,234,0.4);
		font-weight: 400;
		font-style: italic;
		margin: 72px auto 64px;
		max-width: 540px;
		border: none;
		animation: fade-up 0.8s 1s ease both;
	}

	/* Footer */
	.footer {
		display: flex;
		justify-content: space-between;
		color: rgba(245,242,234,0.35);
		font-size: 13px;
	}

	.footer a {
		color: inherit;
		text-decoration: none;
	}

	/* ── Animations ── */
	@keyframes fade-up {
		from { opacity: 0; transform: translateY(14px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@keyframes slide-in-left {
		from { opacity: 0; transform: translateX(-28px); }
		to   { opacity: 1; transform: translateX(0); }
	}

	@keyframes slide-in-right {
		from { opacity: 0; transform: translateX(28px); }
		to   { opacity: 1; transform: translateX(0); }
	}

	@keyframes ring-expand {
		0%   { transform: translate(-50%, -50%) scale(0); opacity: 0.6; }
		80%  { opacity: 0; }
		100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
	}

	@keyframes icon-pulse {
		0%, 100% { box-shadow: 0 0 0 0 rgba(155,138,255,0.3); }
		50%       { box-shadow: 0 0 0 8px rgba(155,138,255,0); }
	}

	@keyframes glow-a {
		0%, 100% { box-shadow: 0 0 30px rgba(243,163,92,0.06); }
		50%       { box-shadow: 0 0 50px rgba(243,163,92,0.16); }
	}

	@keyframes glow-b {
		0%, 100% { box-shadow: 0 0 30px rgba(104,199,209,0.06); }
		50%       { box-shadow: 0 0 50px rgba(104,199,209,0.16); }
	}

	@keyframes dot-pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50%       { opacity: 0.5; transform: scale(0.7); }
	}

	@keyframes pulse-pill {
		0%, 100% { opacity: 1; }
		50%       { opacity: 0.65; }
	}

	/* Responsive */
	@media (max-width: 720px) {
		.arena {
			grid-template-columns: 1fr;
			grid-template-rows: auto auto auto;
		}

		.merge-zone {
			width: 100%;
			flex-direction: row;
			justify-content: center;
			padding: 8px 0;
		}

		.merge-ring { display: none; }
	}
</style>
