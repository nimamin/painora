---
import Layout from '../../layouts/Layout.astro';
import { PAINS } from '../../data/pains';

const categoryColor: Record<string, string> = {
	social:    '#f3a35c',
	work:      '#68c7d1',
	health:    '#e87ea1',
	dev:       '#9b8aff',
	finance:   '#f5d76e',
	community: '#7ec99b',
};

const statusLabel: Record<string, string> = {
	new:     'New',
	active:  'Active',
	merging: 'Merging',
};
---

<Layout>
	<div class="page">
		<header class="nav">
			<a class="logo" href="/">Painora</a>
			<a class="ghost" href="/chat">Declare a pain</a>
		</header>

		<section class="hero reveal">
			<p class="eyebrow">Pain library</p>
			<h1>Real problems. Waiting to be solved.</h1>
			<p class="sub">
				Every card is a structured human pain — clarified by AI, open for designers and builders
				to propose solutions.
			</p>
		</section>

		<div class="grid">
			{PAINS.map((pain, i) => (
				<a
					class={`card reveal delay-${(i % 4) + 1}`}
					href={`/pains/${pain.id}`}
					style={`--accent: ${categoryColor[pain.category]}`}
				>
					<div class="card-top">
						<span class={`status status-${pain.status}`}>{statusLabel[pain.status]}</span>
						<div class="votes">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
							{pain.votes.toLocaleString()}
						</div>
					</div>

					<h2 class="card-title">{pain.title}</h2>
					<p class="card-summary">{pain.summary}</p>

					<div class="card-footer">
						<div class="tags">
							{pain.tags.map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>
						<span class="proposals">{pain.proposals} proposals</span>
					</div>
				</a>
			))}
		</div>

		<div class="cta-strip reveal">
			<p>Have a pain that's not here?</p>
			<a class="primary" href="/chat">Declare yours →</a>
		</div>

		<footer class="footer">
			<span>© 2026 Painora</span>
			<a href="/">← Back to home</a>
		</footer>
	</div>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0c0b11;
		color: #f5f2ea;
		font-family: 'Space Grotesk', system-ui, sans-serif;
	}

	:global(*) { box-sizing: border-box; }

	.page {
		min-height: 100vh;
		padding: 32px clamp(20px, 6vw, 96px) 80px;
		background:
			radial-gradient(circle at 10% 5%, rgba(104,199,209,0.15), transparent 45%),
			radial-gradient(circle at 90% 10%, rgba(243,163,92,0.12), transparent 45%),
			#0c0b11;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 56px;
	}

	.logo {
		font-family: 'Fraunces', serif;
		font-size: 26px;
		color: #f5f2ea;
		text-decoration: none;
	}

	.ghost {
		border: 1px solid rgba(245,242,234,0.2);
		color: #f5f2ea;
		background: rgba(245,242,234,0.05);
		border-radius: 999px;
		padding: 10px 18px;
		font-size: 14px;
		text-decoration: none;
		transition: background 0.2s;
	}

	.ghost:hover { background: rgba(245,242,234,0.1); }

	.primary {
		background: linear-gradient(120deg, #f3a35c, #f16068);
		color: #0c0b11;
		border-radius: 999px;
		padding: 12px 22px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s;
		box-shadow: 0 8px 24px rgba(243,163,92,0.3);
	}

	.primary:hover { transform: translateY(-2px); }

	/* Hero */
	.hero {
		max-width: 640px;
		margin-bottom: 48px;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 12px;
		color: #f3a35c;
		margin: 0 0 12px;
	}

	.hero h1 {
		font-family: 'Fraunces', serif;
		font-size: clamp(32px, 4vw, 52px);
		margin: 0 0 16px;
		line-height: 1.1;
	}

	.sub {
		margin: 0;
		color: rgba(245,242,234,0.7);
		font-size: 17px;
		line-height: 1.6;
	}

	/* Grid */
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 20px;
		margin-bottom: 64px;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 22px 22px 18px;
		border-radius: 22px;
		background: rgba(18,17,28,0.9);
		border: 1px solid rgba(245,242,234,0.07);
		text-decoration: none;
		color: inherit;
		position: relative;
		overflow: hidden;
		transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
	}

	/* accent left stripe */
	.card::before {
		content: '';
		position: absolute;
		left: 0; top: 0; bottom: 0;
		width: 3px;
		background: var(--accent);
		border-radius: 3px 0 0 3px;
		opacity: 0.7;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--accent, rgba(245,242,234,0.2));
		box-shadow: 0 16px 48px rgba(0,0,0,0.45), 0 0 0 1px var(--accent, transparent);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.status {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.status-new     { background: rgba(245,242,234,0.08); color: rgba(245,242,234,0.6); }
	.status-active  { background: rgba(104,199,209,0.15); color: #68c7d1; }
	.status-merging { background: rgba(243,163,92,0.2);  color: #f3a35c; }

	.votes {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 13px;
		color: rgba(245,242,234,0.55);
	}

	.votes svg { opacity: 0.7; }

	.card-title {
		font-family: 'Fraunces', serif;
		font-size: 18px;
		line-height: 1.3;
		margin: 0;
		color: #f5f2ea;
	}

	.card-summary {
		font-size: 14px;
		line-height: 1.55;
		color: rgba(245,242,234,0.65);
		margin: 0;
		flex: 1;
	}

	.card-footer {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 8px;
		margin-top: 4px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tag {
		font-size: 11px;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgba(245,242,234,0.06);
		color: rgba(245,242,234,0.5);
		letter-spacing: 0.04em;
	}

	.proposals {
		font-size: 12px;
		color: rgba(245,242,234,0.4);
		white-space: nowrap;
	}

	/* CTA strip */
	.cta-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		flex-wrap: wrap;
		padding: 28px 32px;
		border-radius: 20px;
		background: rgba(245,242,234,0.04);
		border: 1px solid rgba(245,242,234,0.08);
		margin-bottom: 64px;
	}

	.cta-strip p {
		margin: 0;
		font-size: 17px;
		color: rgba(245,242,234,0.8);
	}

	/* Footer */
	.footer {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		color: rgba(245,242,234,0.4);
		font-size: 13px;
	}

	.footer a {
		color: inherit;
		text-decoration: none;
	}

	/* Animations */
	.reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: fade-up 0.7s ease forwards;
	}

	.delay-1 { animation-delay: 0.05s; }
	.delay-2 { animation-delay: 0.12s; }
	.delay-3 { animation-delay: 0.19s; }
	.delay-4 { animation-delay: 0.26s; }

	@keyframes fade-up {
		to { opacity: 1; transform: translateY(0); }
	}
</style>
