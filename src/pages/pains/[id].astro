---
import Layout from '../../layouts/Layout.astro';
import { PAINS, getPain } from '../../data/pains';

export async function getStaticPaths() {
	return PAINS.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const pain = getPain(id!);
if (!pain) return Astro.redirect('/pains');

const categoryColor: Record<string, string> = {
	social:    '#f3a35c',
	work:      '#68c7d1',
	health:    '#e87ea1',
	dev:       '#9b8aff',
	finance:   '#f5d76e',
	community: '#7ec99b',
};

const accent = categoryColor[pain.category];

// Mock proposals for demo
const mockProposals = [
	{
		id: 1,
		author: 'M. Reyes',
		title: 'A relationship graph with weighted reminder cadences',
		summary:
			'Map contacts by closeness tier. Surface reminders 7, 3, and 1 day before — only for people who matter most.',
		votes: 214,
	},
	{
		id: 2,
		author: 'S. Nakamura',
		title: 'Native OS calendar + gift-suggestion AI layer',
		summary:
			'Sync across all contact sources. One day before, surface a curated shortlist of meaningful gifts based on past interactions.',
		votes: 189,
	},
	{
		id: 3,
		author: 'K. Osei',
		title: 'Community-shared birthday rituals',
		summary:
			'Let mutual friends coordinate on a shared gift or message. One platform entry, zero coordination overhead.',
		votes: 143,
	},
];
---

<Layout>
	<div class="page" style={`--accent: ${accent}`}>
		<header class="nav">
			<a class="back" href="/pains">← Pain library</a>
			<div class="nav-right">
				<span class={`status status-${pain.status}`}>
					{pain.status === 'merging' ? 'Merging now' : pain.status === 'active' ? 'Active' : 'New'}
				</span>
				<a class="primary" href="#propose">Propose a solution</a>
			</div>
		</header>

		<div class="layout">
			<!-- Main content -->
			<main class="main-col">
				<div class="pain-hero reveal">
					<div class="tags">
						{pain.tags.map(tag => <span class="tag">{tag}</span>)}
					</div>
					<h1>{pain.title}</h1>
					<p class="summary">{pain.summary}</p>

					<div class="meta">
						<div class="stat">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
							<strong>{pain.votes.toLocaleString()}</strong> votes
						</div>
						<div class="stat">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M3 17l3-3 3 3 3-3 3 3 3-3"/></svg>
							<strong>{pain.proposals}</strong> proposals
						</div>
					</div>
				</div>

				<!-- Problem Specification -->
				<section class="spec-section reveal delay-1">
					<h2 class="section-title">Problem specification</h2>
					<div class="spec-grid">
						<div class="spec-field">
							<span class="field-label">Pain title</span>
							<p class="field-value">{pain.spec.title}</p>
						</div>
						<div class="spec-field">
							<span class="field-label">Context</span>
							<p class="field-value">{pain.spec.context}</p>
						</div>
						<div class="spec-field">
							<span class="field-label">Root cause</span>
							<p class="field-value">{pain.spec.rootCause}</p>
						</div>
						<div class="spec-field">
							<span class="field-label">Who feels it</span>
							<p class="field-value">{pain.spec.whoFeelsIt}</p>
						</div>
						<div class="spec-field">
							<span class="field-label">Why it persists</span>
							<p class="field-value">{pain.spec.whyItPersists}</p>
						</div>
					</div>
				</section>

				<!-- Solution proposals -->
				<section class="proposals-section reveal delay-2">
					<div class="proposals-header">
						<h2 class="section-title">Solution proposals</h2>
						<span class="count">{pain.proposals} submitted</span>
					</div>

					<div class="proposals-list">
						{mockProposals.map((p) => (
							<div class="proposal-card">
								<div class="proposal-top">
									<div>
										<span class="proposal-author">{p.author}</span>
										<h3 class="proposal-title">{p.title}</h3>
									</div>
									<div class="proposal-votes">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
										{p.votes}
									</div>
								</div>
								<p class="proposal-summary">{p.summary}</p>
							</div>
						))}
					</div>
				</section>

				<!-- Propose form -->
				<section class="propose-section reveal delay-3" id="propose">
					<h2 class="section-title">Propose your solution</h2>
					<p class="propose-sub">Your proposal stays visible as its own IP. The community may invite it to merge.</p>
					<form class="propose-form" id="proposeForm">
						<label>
							<span>Title</span>
							<input type="text" placeholder="One-line description of your approach" />
						</label>
						<label>
							<span>Approach</span>
							<textarea rows="4" placeholder="How would you solve this? What's the key insight?"></textarea>
						</label>
						<button type="submit">Submit proposal</button>
					</form>
				</section>
			</main>

			<!-- Lineage sidebar -->
			<aside class="lineage-col reveal delay-2">
				<div class="lineage-card">
					<p class="lineage-label">Ownership lineage</p>
					<div class="lineage-steps">
						<div class="lineage-step active">
							<div class="step-dot"></div>
							<div class="step-body">
								<strong>Pain declared</strong>
								<span>Anonymous · 14 days ago</span>
							</div>
						</div>
						<div class="lineage-line"></div>
						<div class="lineage-step active">
							<div class="step-dot"></div>
							<div class="step-body">
								<strong>Spec v1</strong>
								<span>AI-structured · validated</span>
							</div>
						</div>
						<div class="lineage-line"></div>
						<div class={`lineage-step ${pain.proposals > 0 ? 'active' : ''}`}>
							<div class="step-dot"></div>
							<div class="step-body">
								<strong>{pain.proposals} proposals</strong>
								<span>{pain.proposals > 0 ? 'Open for contribution' : 'None yet'}</span>
							</div>
						</div>
						<div class="lineage-line"></div>
						<div class={`lineage-step ${pain.status === 'merging' ? 'active' : ''}`}>
							<div class="step-dot"></div>
							<div class="step-body">
								<strong>Merge festival</strong>
								<span>{pain.status === 'merging' ? 'In progress' : 'Pending'}</span>
							</div>
						</div>
						<div class="lineage-line"></div>
						<div class="lineage-step">
							<div class="step-dot"></div>
							<div class="step-body">
								<strong>Build</strong>
								<span>Not started</span>
							</div>
						</div>
					</div>
				</div>

				<div class="ip-card">
					<p class="lineage-label">IP ownership</p>
					<p class="ip-note">
						Every meaningful contribution is tracked. Designers who propose solutions retain authorship. Merge contributors receive attribution and revenue participation.
					</p>
					<div class="ip-pill">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2z"/><path d="M2 20c0-4 4.5-7 10-7s10 3 10 7"/></svg>
						IP stays with creators
					</div>
				</div>
			</aside>
		</div>

		<footer class="footer">
			<span>© 2026 Painora</span>
			<a href="/pains">← Back to library</a>
		</footer>
	</div>
</Layout>

<script>
	const form = document.getElementById('proposeForm') as HTMLFormElement;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const btn = form.querySelector('button')!;
		btn.textContent = 'Proposal submitted ✓';
		btn.classList.add('submitted');
		btn.setAttribute('disabled', '');
	});
</script>

<style>
	:global(body) {
		margin: 0;
		background: #0c0b11;
		color: #f5f2ea;
		font-family: 'Space Grotesk', system-ui, sans-serif;
	}

	:global(*) { box-sizing: border-box; }

	.page {
		min-height: 100vh;
		padding: 32px clamp(20px, 5vw, 80px) 80px;
		background:
			radial-gradient(circle at 5% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 40%),
			#0c0b11;
	}

	/* Nav */
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 48px;
		flex-wrap: wrap;
	}

	.back {
		color: rgba(245,242,234,0.65);
		text-decoration: none;
		font-size: 14px;
		transition: color 0.2s;
	}

	.back:hover { color: #f5f2ea; }

	.nav-right { display: flex; align-items: center; gap: 12px; }

	.status {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 5px 12px;
		border-radius: 999px;
	}

	.status-new     { background: rgba(245,242,234,0.08); color: rgba(245,242,234,0.6); }
	.status-active  { background: rgba(104,199,209,0.15); color: #68c7d1; }
	.status-merging { background: rgba(243,163,92,0.2);  color: #f3a35c; }

	.primary {
		background: linear-gradient(120deg, #f3a35c, #f16068);
		color: #0c0b11;
		border-radius: 999px;
		padding: 11px 20px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s;
		box-shadow: 0 6px 20px rgba(243,163,92,0.3);
	}

	.primary:hover { transform: translateY(-2px); }

	/* Layout */
	.layout {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 40px;
		align-items: start;
		max-width: 1100px;
	}

	/* Pain hero */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}

	.tag {
		font-size: 12px;
		padding: 4px 12px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 15%, transparent);
		color: var(--accent);
		letter-spacing: 0.05em;
	}

	.pain-hero h1 {
		font-family: 'Fraunces', serif;
		font-size: clamp(28px, 4vw, 48px);
		line-height: 1.15;
		margin: 0 0 16px;
	}

	.summary {
		font-size: 17px;
		line-height: 1.65;
		color: rgba(245,242,234,0.75);
		margin: 0 0 20px;
		max-width: 600px;
	}

	.meta {
		display: flex;
		gap: 24px;
	}

	.stat {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		color: rgba(245,242,234,0.55);
	}

	.stat strong { color: #f5f2ea; }

	/* Section styles */
	.section-title {
		font-family: 'Fraunces', serif;
		font-size: 22px;
		margin: 0 0 20px;
		color: #f5f2ea;
	}

	.spec-section,
	.proposals-section,
	.propose-section {
		margin-top: 48px;
		padding-top: 48px;
		border-top: 1px solid rgba(245,242,234,0.07);
	}

	/* Spec grid */
	.spec-grid {
		display: grid;
		gap: 12px;
	}

	.spec-field {
		padding: 16px 18px;
		border-radius: 16px;
		background: rgba(245,242,234,0.03);
		border: 1px solid rgba(245,242,234,0.07);
		transition: border-color 0.2s;
	}

	.spec-field:hover {
		border-color: color-mix(in srgb, var(--accent) 30%, transparent);
	}

	.field-label {
		display: block;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: rgba(245,242,234,0.4);
		margin-bottom: 6px;
	}

	.field-value {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		color: rgba(245,242,234,0.9);
	}

	/* Proposals */
	.proposals-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 20px;
	}

	.proposals-header .section-title { margin: 0; }

	.count {
		font-size: 13px;
		color: rgba(245,242,234,0.45);
	}

	.proposals-list { display: grid; gap: 14px; }

	.proposal-card {
		padding: 18px 20px;
		border-radius: 18px;
		background: rgba(18,17,28,0.9);
		border: 1px solid rgba(245,242,234,0.07);
		transition: border-color 0.2s;
	}

	.proposal-card:hover {
		border-color: color-mix(in srgb, var(--accent) 30%, transparent);
	}

	.proposal-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 8px;
	}

	.proposal-author {
		display: block;
		font-size: 12px;
		color: rgba(245,242,234,0.45);
		margin-bottom: 4px;
	}

	.proposal-title {
		font-size: 15px;
		font-weight: 600;
		margin: 0;
		color: #f5f2ea;
		line-height: 1.35;
	}

	.proposal-votes {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 13px;
		color: rgba(245,242,234,0.5);
		white-space: nowrap;
		padding-top: 2px;
	}

	.proposal-summary {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: rgba(245,242,234,0.65);
	}

	/* Propose form */
	.propose-sub {
		margin: -8px 0 20px;
		font-size: 14px;
		color: rgba(245,242,234,0.55);
	}

	.propose-form {
		display: grid;
		gap: 16px;
	}

	.propose-form label {
		display: grid;
		gap: 8px;
	}

	.propose-form label span {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: rgba(245,242,234,0.5);
	}

	.propose-form input,
	.propose-form textarea {
		background: rgba(18,17,28,0.9);
		border: 1px solid rgba(245,242,234,0.12);
		border-radius: 14px;
		padding: 14px 16px;
		color: #f5f2ea;
		font-size: 15px;
		font-family: inherit;
		outline: none;
		resize: vertical;
		transition: border-color 0.2s;
	}

	.propose-form input:focus,
	.propose-form textarea:focus {
		border-color: var(--accent, rgba(245,242,234,0.3));
	}

	.propose-form button {
		justify-self: start;
		border: none;
		border-radius: 999px;
		padding: 13px 28px;
		font-size: 15px;
		font-weight: 500;
		font-family: inherit;
		background: linear-gradient(120deg, #f3a35c, #f16068);
		color: #0c0b11;
		cursor: pointer;
		transition: transform 0.2s, box-shadow 0.2s;
		box-shadow: 0 6px 20px rgba(243,163,92,0.3);
	}

	.propose-form button:hover:not(:disabled) { transform: translateY(-2px); }

	.propose-form button.submitted {
		background: rgba(104,199,209,0.2);
		color: #68c7d1;
		box-shadow: none;
		cursor: default;
	}

	/* Lineage sidebar */
	.lineage-col {
		position: sticky;
		top: 32px;
		display: grid;
		gap: 16px;
	}

	.lineage-card,
	.ip-card {
		padding: 22px;
		border-radius: 20px;
		background: rgba(18,17,28,0.9);
		border: 1px solid rgba(245,242,234,0.07);
	}

	.lineage-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgba(245,242,234,0.4);
		margin: 0 0 20px;
	}

	.lineage-steps { display: flex; flex-direction: column; }

	.lineage-step {
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}

	.step-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(245,242,234,0.15);
		border: 2px solid rgba(245,242,234,0.2);
		flex-shrink: 0;
		margin-top: 3px;
		transition: background 0.3s, border-color 0.3s;
	}

	.lineage-step.active .step-dot {
		background: var(--accent, #68c7d1);
		border-color: var(--accent, #68c7d1);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
	}

	.step-body {
		display: grid;
		gap: 2px;
		padding-bottom: 4px;
	}

	.step-body strong {
		font-size: 13px;
		font-weight: 500;
		color: rgba(245,242,234,0.85);
	}

	.step-body span {
		font-size: 12px;
		color: rgba(245,242,234,0.4);
	}

	.lineage-line {
		width: 1px;
		height: 20px;
		background: rgba(245,242,234,0.1);
		margin-left: 4px;
	}

	.ip-note {
		font-size: 13px;
		line-height: 1.6;
		color: rgba(245,242,234,0.55);
		margin: 0 0 14px;
	}

	.ip-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		padding: 6px 12px;
		border-radius: 999px;
		background: rgba(104,199,209,0.12);
		color: #68c7d1;
	}

	/* Footer */
	.footer {
		margin-top: 80px;
		display: flex;
		justify-content: space-between;
		color: rgba(245,242,234,0.35);
		font-size: 13px;
	}

	.footer a {
		color: inherit;
		text-decoration: none;
	}

	/* Animations */
	.reveal {
		opacity: 0;
		transform: translateY(12px);
		animation: fade-up 0.7s ease forwards;
	}

	.delay-1 { animation-delay: 0.08s; }
	.delay-2 { animation-delay: 0.16s; }
	.delay-3 { animation-delay: 0.24s; }

	@keyframes fade-up {
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 840px) {
		.layout {
			grid-template-columns: 1fr;
		}

		.lineage-col {
			position: static;
		}
	}
</style>
